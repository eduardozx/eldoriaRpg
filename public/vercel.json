{
  "framework": null,
  "buildCommand": null,
  "installCommand": "echo no-install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/Eldoria.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        { 
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        { 
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}
